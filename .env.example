# =============================================================================
# Variables de entorno de Black Legend DayZ
# Copia este archivo como .env.local (para desarrollo) y rellena los valores.
# En producción, configúralas en Vercel → Settings → Environment Variables.
# NO subas valores reales al repositorio: .env.local está en .gitignore.
# =============================================================================

# ---- Comunicados desde Discord (sección "Últimos comunicados") --------------
# Token de un bot de Discord con el "Message Content Intent" activado y acceso
# al canal de comunicados, y el ID de ese canal.
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# ---- Panel de administración (/admin) ---------------------------------------
# Contraseña única de acceso al panel (elige una fuerte).
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Almacenamiento de fotos (Vercel Blob) ----------------------------------
# Se añade SOLO al crear un store de Vercel Blob en el proyecto
# (Vercel -> Storage -> Create Database -> Blob). No hace falta copiarlo a mano.
BLOB_READ_WRITE_TOKEN=
